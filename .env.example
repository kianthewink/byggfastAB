# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (Neon Postgres) ---
# From your Neon project (or Vercel Storage tab -> Postgres -> .env.local tab).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- File storage (Vercel Blob) — OPTIONAL ---
# Leave unset to run without file storage: existing image URLs keep working,
# new uploads are disabled in the UI. Set it later to enable uploads.
# From Vercel Storage tab -> Blob -> your store -> .env.local tab.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Auth ---
# Random signing secret for session cookies. Signs both the admin session and
# the visitor sessions created at /mina-sidor; the two are kept apart by a
# `typ` claim, not by separate secrets. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=""

# The root admin login — plain text, just type whatever you want here. This is
# the one account that cannot be removed from inside the panel, so there is
# always a way back in.
# Site visitors are NOT configured here: they register at /mina-sidor/registrera
# and live in the `users` table with scrypt-hashed passwords.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Six-digit PIN that gates "Bjud in administratör" at
# /administrator/administratorer. Unlike ADMIN_PASSWORD this is only a
# bootstrap value: the first time it is used it is hashed with scrypt into the
# `admin_secrets` table, and the database row is the source of truth from then
# on. You can change the PIN from inside the panel and delete this line
# afterwards. Must be exactly six digits.
ADMIN_INVITE_PIN="123456"
